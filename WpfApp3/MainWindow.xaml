<Window x:Class="WpfApp3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp3"
        mc:Ignorable="d"
        Title="飲料訂購系統ver3" Height="800" Width="1266">
    <Grid Margin="24,24,24,5">
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="400"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="425*"/>
            <ColumnDefinition Width="0*"/>
            <ColumnDefinition Width="283*"/>
            <ColumnDefinition Width="142*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" Background="#FF656594" Grid.ColumnSpan="4" HorizontalAlignment="Left" Width="850" Height="72" VerticalAlignment="Center" Margin="10,0,0,0">
            <GroupBox Header="內用/外帶" Width="204">
                <StackPanel Orientation="Horizontal" Grid.ColumnSpan="2" Background="#FF9BC0F1" Margin="8" RenderTransformOrigin="0.831,0.52">
                    <RadioButton x:Name="RadioButton1" Content="內用" FontSize="14" FontWeight="Bold" VerticalContentAlignment="Center" Checked="RadioButton_Checked"/>
                    <RadioButton x:Name="RadioButton2" Content="外帶" Margin="80,0,0,0" FontSize="14" FontWeight="Bold" VerticalContentAlignment="Center" Checked="RadioButton_Checked"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>

        <StackPanel x:Name="DrinkMenuStackPanel" Orientation="Vertical" Grid.Row="1" Background="#FFBEE467">
            <!-- 動態加入飲料項目 -->
        </StackPanel>

        <Button x:Name="OrderButton" Content="訂購" FontSize="16" Click="OrderButton_Click" MinWidth="50" Margin="479,-1,36,0" RenderTransformOrigin="0.683,0.543" Height="72" VerticalAlignment="Top">
            <Button.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="0.29"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Button.RenderTransform>
        </Button>

        <TextBlock x:Name="ResultTextBlock" Grid.Row="2" TextWrapping="Wrap" Background="#FFFBEEE5" Grid.ColumnSpan="4" FontSize="14" Padding="10"/>
    </Grid>
</Window>